# --- server ---
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/restaurant

# --- auth ---
JWT_SECRET=replace_with_a_long_random_string_of_at_least_16_chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# --- business ---
TIMEZONE=Africa/Cairo
DEFAULT_COUNTRY_CODE=20

# --- http ---
# Comma separated browser origins allowed by CORS. Empty means none.
CORS_ORIGIN=

# --- background jobs (no-show, uncollected, auto-complete) ---
ENABLE_JOBS=true

# --- seed script: first admin account (npm run seed) ---
ADMIN_NAME=Administrator
ADMIN_PHONE=+201000000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me_min_8_chars
