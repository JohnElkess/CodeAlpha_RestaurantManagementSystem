{
  "name": "codealpha-restaurant-management-system",
  "version": "1.0.0",
  "description": "Restaurant Management System: REST API for menu, reservations, orders and ingredient-level inventory",
  "main": "src/server.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "node src/seed/seed.js"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.4",
    "node-cron": "^4.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/setup_env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*_test.js"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/seed/**"
    ]
  }
}
